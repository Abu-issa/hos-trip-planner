# Export these variables in your shell; Django does not automatically load this file.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required when DJANGO_DEBUG=false. Supply your own secret outside version control.
# DJANGO_SECRET_KEY=

NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSRM_BASE_URL=https://router.project-osrm.org
PROVIDER_USER_AGENT=SpotterTripPlannerAssessment/0.2 (local development)
PROVIDER_TIMEOUT_SECONDS=10

# Production: set DEBUG=false, an exact backend hostname and frontend origin,
# and a private SECRET_KEY. These examples retain local development behavior.
# Set TRUST_PROXY=true only behind Render's trusted HTTPS-terminating proxy.
DJANGO_TRUST_PROXY=false
# Defaults to true when DEBUG=false; normally omit this override.
# DJANGO_SECURE_SSL_REDIRECT=true
# Start at 0; optionally set 3600 after verifying HTTPS. No subdomains/preload.
DJANGO_SECURE_HSTS_SECONDS=0
# Gunicorn reads Render's automatically supplied PORT (local default 8000).
